APP_ENV=production
APP_NAME=Greenhouse Monitor
APP_VERSION=1.0.0
APP_SECRET_KEY=change-me-to-a-long-random-value
DATABASE_URL=postgresql+psycopg://greenhouse:password@postgres:5432/greenhouse
POSTGRES_DB=greenhouse
POSTGRES_USER=greenhouse
POSTGRES_PASSWORD=change-me
CORS_ORIGINS=http://localhost,http://raspberrypi.local
DEVICE_OFFLINE_THRESHOLD_SECONDS=15
MAX_REQUEST_BODY_BYTES=16384
DEFAULT_TIMEZONE=Europe/Kyiv
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RATE_LIMIT_MEASUREMENTS_PER_MINUTE=120
ENABLE_OPENAPI=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/api/v1/ws/measurements
